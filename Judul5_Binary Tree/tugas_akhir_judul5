class Siswa:
    def __init__(self, nilai):
        self.nilai = nilai
        self.kiri = None
        self.kanan = None


class DataNilaiSiswa:
    def __init__(self):
        self.root = None

    def tambah_nilai_node(self, root, nilai):
        if root is None:
            return Siswa(nilai)

        if nilai < root.nilai:
            root.kiri = self.tambah_nilai_node(root.kiri, nilai)

        elif nilai > root.nilai:
            root.kanan = self.tambah_nilai_node(root.kanan, nilai)

        return root

    def tambah_nilai(self, nilai):
        self.root = self.tambah_nilai_node(self.root, nilai)

    def cari_nilai_node(self, root, nilai):
        if root is None:
            return False

        if root.nilai == nilai:
            return True

        if nilai < root.nilai:
            return self.cari_nilai_node(root.kiri, nilai)

        return self.cari_nilai_node(root.kanan, nilai)

    def cari_nilai(self, nilai):
        return self.cari_nilai_node(self.root, nilai)

    def inorder(self, root):
        if root is None:
            return

        self.inorder(root.kiri)
        print(root.nilai, end=" ")
        self.inorder(root.kanan)

    def preorder(self, root):
        if root is None:
            return

        print(root.nilai, end=" ")
        self.preorder(root.kiri)
        self.preorder(root.kanan)

    def postorder(self, root):
        if root is None:
            return

        self.postorder(root.kiri)
        self.postorder(root.kanan)
        print(root.nilai, end=" ")

    def nilai_terendah(self, root):
        if root is None:
            return -1

        current = root

        while current.kiri is not None:
            current = current.kiri

        return current.nilai

    def nilai_tertinggi(self, root):
        if root is None:
            return -1

        current = root

        while current.kanan is not None:
            current = current.kanan

        return current.nilai

    def jumlah_siswa(self, root):
        if root is None:
            return 0

        return 1 + self.jumlah_siswa(root.kiri) + self.jumlah_siswa(root.kanan)

    def total_nilai(self, root):
        if root is None:
            return 0

        return (
            root.nilai
            + self.total_nilai(root.kiri)
            + self.total_nilai(root.kanan)
        )


def main():
    sekolah = DataNilaiSiswa()
    pilih = 0

    while pilih != 10:
        print("\n SISTEM DATA NILAI SISWA")
        print("1. insert ")
        print("2. search ")
        print("3. inorder")
        print("4. preorder")
        print("5. postorder")
        print("6. Min")
        print("7. Max")
        print("8. Count Nodes")
        print("9. Sum Nodes")
        print("10. Keluar")

        try:
            pilih = int(input("Pilih menu: "))
        except ValueError:
            print("Input harus angka!")
            continue

        if pilih == 1:
            try:
                nilai = int(input("Masukkan nilai siswa: "))
                sekolah.tambah_nilai(nilai)
                print(f"Nilai {nilai} berhasil ditambahkan")

            except ValueError:
                print("Input tidak valid!")

        elif pilih == 2:
            try:
                nilai = int(input("Cari nilai siswa: "))

                if sekolah.cari_nilai(nilai):
                    print("Nilai ditemukan")
                else:
                    print("Nilai tidak ditemukan")

            except ValueError:
                print("Input tidak valid!")

        elif pilih == 3:
            print("Inorder: ", end="")
            sekolah.inorder(sekolah.root)
            print()

        elif pilih == 4:
            print("Preorder: ", end="")
            sekolah.preorder(sekolah.root)
            print()

        elif pilih == 5:
            print("Postorder: ", end="")
            sekolah.postorder(sekolah.root)
            print()

        elif pilih == 6:
            print("Nilai terendah:", sekolah.nilai_terendah(sekolah.root))

        elif pilih == 7:
            print("Nilai tertinggi:", sekolah.nilai_tertinggi(sekolah.root))

        elif pilih == 8:
            print("Jumlah siswa:", sekolah.jumlah_siswa(sekolah.root))

        elif pilih == 9:
            print("Total seluruh nilai:", sekolah.total_nilai(sekolah.root))

        elif pilih == 10:
            print("Program selesai")

        else:
            print("Pilihan tidak tersedia")


if __name__ == "__main__":
    main()
